{
  "name": "ocg-platform",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "db:generate": "pnpm --filter @ocg/db run generate",
    "db:migrate": "pnpm --filter @ocg/db run migrate",
    "db:check": "pnpm --filter @ocg/db run check",
    "pg": "scripts/local-pg.sh",
    "user:create": "pnpm --filter @ocg/web run user:create",
    "seed:example": "pnpm --filter @ocg/web run seed:example",
    "batch": "pnpm --filter @ocg/web run batch"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "~6.0.3"
  }
}
