      "policies": {},
      "checkConstraints": {
        "alignment_target_kind": {
          "name": "alignment_target_kind",
          "value": "CASE \"overlay\".\"alignment\".\"alignment_type\"\n            WHEN 'reveals' THEN \"overlay\".\"alignment\".\"target_kind\" = 'misconception'\n            WHEN 'covers' THEN \"overlay\".\"alignment\".\"target_kind\" IN ('statement', 'node')\n            ELSE \"overlay\".\"alignment\".\"target_kind\" IN ('concept', 'level')\n          END"
        },
        "alignment_ai_source": {
          "name": "alignment_ai_source",
          "value": "\"overlay\".\"alignment\".\"source_kind\" <> 'ai' OR (\"overlay\".\"alignment\".\"source_model\" IS NOT NULL AND \"overlay\".\"alignment\".\"source_prompt_version\" IS NOT NULL)"
        },
        "alignment_person_source": {
          "name": "alignment_person_source",
          "value": "\"overlay\".\"alignment\".\"source_kind\" <> 'person' OR \"overlay\".\"alignment\".\"source_by\" IS NOT NULL"
        },
        "alignment_confidence": {
          "name": "alignment_confidence",
          "value": "\"overlay\".\"alignment\".\"confidence\" BETWEEN 0 AND 1"
        },
        "alignment_rationale_lang": {
          "name": "alignment_rationale_lang",
          "value": "overlay.is_lang_string(\"overlay\".\"alignment\".\"rationale\")"
        }
      },
      "isRLSEnabled": false
    },
