# Copy to .env.local (never committed). scripts/local-pg.sh prints the two database URLs.

# Working database. Any Postgres 16+; Neon in production (its pooled string).
DATABASE_URL=postgres://user@localhost/ocg?host=/path/to/platform/.local/pg

# A direct (unpooled) connection for migrations, where the working one is pooled.
# Leave unset locally. See docs/deploy.md.
DATABASE_URL_UNPOOLED=

# Database the tests may wipe. Must not be the working database.
TEST_DATABASE_URL=postgres://user@localhost/ocg_test?host=/path/to/platform/.local/pg

# A client workspace's own database, for pnpm overlay (ADR-034): never the
# working database above. Locally, for fictional data only.
OVERLAY_DATABASE_URL=postgres://user@localhost/ocg_workspace?host=/path/to/platform/.local/pg

# Session signing secret, at least 32 random characters: openssl rand -base64 32
# (production refuses to start without one)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Other addresses people use to reach the app, comma-separated full origins,
# e.g. a dev server shared on a private network: https://devbox.example.ts.net:8444
BETTER_AUTH_TRUSTED_ORIGINS=

# Where each page's "Source code" link points (AGPL-3.0 section 13). Leave empty
# to use github.com/openconceptgraph/platform; if you run a changed version for
# other people, point it at your own copy's source.
SOURCE_REPOSITORY_URL=
